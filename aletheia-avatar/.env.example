# Aletheia Avatar local runner v05
# Copy this file to .env and edit LOCAL paths only.
# Never commit .env.

# Folder containing LivePortrait inference.py
LIVEPORTRAIT_DIR=

# Python executable for the LivePortrait environment.
# Example on Windows:
# LIVEPORTRAIT_PYTHON=C:\Users\you\miniconda3\envs\LivePortrait\python.exe
LIVEPORTRAIT_PYTHON=

# Folder containing MuseTalk scripts/ and models/
MUSETALK_DIR=

# Python executable for the MuseTalk environment.
MUSETALK_PYTHON=

# Optional ffmpeg executable. Leave blank when ffmpeg is already on PATH.
FFMPEG_BIN=

# Optional local port.
ALETHEIA_AVATAR_PORT=8765

# Cloud keys are optional and are NOT required for the local Dad Presenter route.
# VIGGLE_API_KEY=
# GEMINI_API_KEY=
# HEDRA_API_KEY=
