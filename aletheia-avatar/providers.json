{
  "version": 2,
  "default_engine": "auto",
  "cost_ceiling_gbp": 0.0,
  "providers": [
    {
      "id": "local_presenter",
      "label": "Local Presenter",
      "supports": [
        "talking_avatar",
        "portrait_animation",
        "motion_transfer",
        "lip_sync"
      ],
      "execution": ["local"],
      "requires": ["LIVEPORTRAIT_DIR", "MUSETALK_DIR"],
      "optional": ["FFMPEG_BIN", "LIVEPORTRAIT_PYTHON", "MUSETALK_PYTHON"],
      "third_party_upload": false,
      "status": "working-adapter",
      "components": ["LivePortrait", "MuseTalk"],
      "docs": [
        "https://github.com/KlingAIResearch/LivePortrait",
        "https://github.com/TMElyralab/MuseTalk"
      ]
    },
    {
      "id": "viggle",
      "label": "Viggle",
      "supports": ["character_replacement", "motion_transfer", "video_remix"],
      "execution": ["api"],
      "requires": ["VIGGLE_API_KEY"],
      "third_party_upload": true,
      "status": "optional-cloud-adapter",
      "docs": ["https://viggle.ai/developers"]
    },
    {
      "id": "veo",
      "label": "Google Veo",
      "supports": ["text_to_video", "image_to_video", "video_to_video", "scene_generation"],
      "execution": ["api"],
      "requires": ["GEMINI_API_KEY"],
      "third_party_upload": true,
      "status": "optional-cloud-adapter",
      "docs": ["https://ai.google.dev/gemini-api/docs/veo"]
    },
    {
      "id": "hedra",
      "label": "Hedra",
      "supports": ["talking_avatar", "video_generation", "multi_model_gateway"],
      "execution": ["api", "cli", "mcp"],
      "requires": ["HEDRA_API_KEY"],
      "third_party_upload": true,
      "status": "optional-cloud-adapter",
      "docs": ["https://www.hedra.com/develop/models/video"]
    }
  ]
}
